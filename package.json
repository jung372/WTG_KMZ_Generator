{
  "name": "wtg-kmz-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Offline Windows wind turbine KMZ generator",
  "author": "WTG KMZ Generator",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/smoke.mjs",
    "dist:win": "npm run build && node scripts/build-windows.mjs",
    "verify:release": "node scripts/release.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.0",
    "@xmldom/xmldom": "0.9.12",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
